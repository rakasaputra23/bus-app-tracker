<?xml version="1.0" encoding="utf-8"?>
<!-- ✅ Info Window KOTAK KECIL - Sesuai MainActivity Adapter -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="120dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/info_window_background"
    android:padding="10dp">

    <!-- Header Compact -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <!-- Bus Icon Small -->
        <View
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bus_icon_background"/>

        <!-- Name -->
        <TextView
            android:id="@+id/tvInfoBusName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#1F2937"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginStart="6dp"
            tools:text="STJ Exp 01"/>

    </LinearLayout>

    <!-- Plate & Class -->
    <TextView
        android:id="@+id/tvInfoPlateClass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="9sp"
        android:textColor="#6B7280"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginBottom="6dp"
        tools:text="B 1234 STJ • EKS"/>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#E5E7EB"
        android:layout_marginBottom="6dp"/>

    <!-- Stats Compact -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Row 1: Penumpang -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Penumpang:"
                android:textSize="8sp"
                android:textColor="#6B7280"/>

            <TextView
                android:id="@+id/tvInfoPassengers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="8sp"
                android:textStyle="bold"
                android:textColor="#1F2937"
                tools:text="3/40"/>

        </LinearLayout>

        <!-- Row 2: Kecepatan -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Kecepatan:"
                android:textSize="8sp"
                android:textColor="#6B7280"/>

            <TextView
                android:id="@+id/tvInfoSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="8sp"
                android:textStyle="bold"
                android:textColor="#1F2937"
                tools:text="2.8 km/j"/>

        </LinearLayout>

        <!-- Row 3: Total Jarak -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total Jarak:"
                android:textSize="8sp"
                android:textColor="#6B7280"/>

            <TextView
                android:id="@+id/tvInfoTotalDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="8sp"
                android:textStyle="bold"
                android:textColor="#1F2937"
                tools:text="0.02 km"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>