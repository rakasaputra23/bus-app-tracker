<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Google Maps Fragment -->
    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Modern Search Bar with Shadow -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="6dp"
            android:gravity="center_vertical">

            <!-- Search Icon Circle -->
            <LinearLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_search_icon"
                android:gravity="center"
                android:layout_marginStart="2dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_search"
                    android:tint="#757575"
                    android:contentDescription="Search" />

            </LinearLayout>

            <!-- Search Input -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/searchInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Cari Jurusan..."
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColorHint="#9E9E9E"
                    android:textColor="#212121"
                    android:background="@android:color/transparent"
                    android:inputType="text"
                    android:imeOptions="actionSearch"
                    android:maxLines="1"
                    android:paddingTop="8dp"
                    android:paddingBottom="0dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contoh: Surabaya, Madiun"
                    android:textSize="10sp"
                    android:textColor="#BDBDBD"
                    android:paddingTop="2dp"
                    android:paddingBottom="8dp" />

            </LinearLayout>

            <!-- Filter Button Circle (Blue) -->
            <LinearLayout
                android:id="@+id/btnFilter"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_filter_button"
                android:gravity="center"
                android:layout_marginEnd="2dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    android:tint="#2196F3"
                    android:contentDescription="Filter" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ===== LEGEND LENGKAP: 3 Jenis Garis ===== -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|bottom"
        android:layout_margin="16dp"
        android:layout_marginBottom="100dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@android:color/white">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:paddingHorizontal="18dp">

            <!-- Header Legend -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Map Legend"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="#212121"
                android:layout_marginBottom="12dp" />

            <!-- ===== 1. Planned Route (Orange Dashed) ===== -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <!-- Dashed Line Preview - ORANGE -->
                <LinearLayout
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="4dp"
                        android:background="#FF6F00" />

                    <View
                        android:layout_width="3dp"
                        android:layout_height="4dp"
                        android:background="@android:color/transparent" />

                    <View
                        android:layout_width="8dp"
                        android:layout_height="4dp"
                        android:background="#FF6F00" />

                    <View
                        android:layout_width="3dp"
                        android:layout_height="4dp"
                        android:background="@android:color/transparent" />

                    <View
                        android:layout_width="8dp"
                        android:layout_height="4dp"
                        android:background="#FF6F00" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Planned Route"
                    android:textSize="11sp"
                    android:textColor="#616161"
                    android:layout_marginStart="10dp" />

            </LinearLayout>

            <!-- ===== 2. Actual Track (Blue Solid) ===== -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <!-- Solid Line Preview - BLUE -->
                <View
                    android:layout_width="36dp"
                    android:layout_height="4dp"
                    android:background="#2196F3" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Actual Track"
                    android:textSize="11sp"
                    android:textColor="#616161"
                    android:layout_marginStart="10dp" />

            </LinearLayout>

            <!-- ===== 3. User Distance (Gray Dotted) ⭐ BARU ===== -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Dotted Line Preview - GRAY -->
                <LinearLayout
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="#9E9E9E" />

                    <View
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:background="@android:color/transparent" />

                    <View
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="#9E9E9E" />

                    <View
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:background="@android:color/transparent" />

                    <View
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="#9E9E9E" />

                    <View
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:background="@android:color/transparent" />

                    <View
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="#9E9E9E" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Your Distance"
                    android:textSize="11sp"
                    android:textColor="#616161"
                    android:layout_marginStart="10dp" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Floating Action Button - My Location -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabMyLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_margin="24dp"
        android:layout_marginBottom="100dp"
        android:contentDescription="My Location"
        android:src="@android:drawable/ic_menu_mylocation"
        app:tint="@android:color/white"
        app:backgroundTint="#2196F3"
        app:elevation="6dp"
        app:fabSize="normal" />

    <!-- Bottom Sheet untuk Detail Bus -->
    <include layout="@layout/bottom_sheet_bus_info" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>